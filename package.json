{
  "name": "interactive-scheme",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p functions",
    "dev": "npm run build && wrangler pages dev public",
    "deploy": "npm run build && wrangler pages deploy public",
    "db:migrate": "wrangler d1 migrations apply interactive-scheme-db"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.9.3",
    "wrangler": "^3.28.0"
  },
  "type": "module"
}
